# Supabase (Dashboard > Settings > API)
SUPABASE_URL=https://gjdslociicdkmjxxznyf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Chave que cifra a senha do ERP (a mesma das Edge Functions)
ERP_SECRET_KEY=

# API do Millennium
MILLENNIUM_API_BASE=http://177.85.160.35:6017/api

# O que entra depois do onboarding (sempre com hoje; do mais recente para o mais antigo):
#   off  = nada automatico: sem vendas de hoje ao conectar, sem historico, sem atualizacao
#          automatica e sem fechamento da madrugada (o Atualizar manual continua)
#   hoje = so hoje
#   1d = hoje + ontem | 7d = hoje + ultimos 7 dias
#   1m = mes atual | 2m = mes atual + anterior | 3m = mes atual + 2 anteriores ...
SYNC_ONBOARDING=1m

# Fechamento de ontem: hora local em que comeca (0-23). off = desligado.
CLOSE_HOUR=3

# Historico antigo na madrugada (mes a mes ate a inauguracao da loja, teto 24 meses).
# 1 = ligado | ausente ou 0 = desligado
DEEP_HISTORY=0

# Opcional: 1 = mostra no terminal cada etapa do sync (debug).
# SYNC_LOG_VERBOSE=1
