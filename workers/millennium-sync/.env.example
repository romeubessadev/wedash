# Supabase (Dashboard > Settings > API)
SUPABASE_URL=https://gjdslociicdkmjxxznyf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Chave que cifra a senha do ERP (a mesma das Edge Functions)
ERP_SECRET_KEY=

# API do Millennium
MILLENNIUM_API_BASE=http://177.85.160.35:6017/api

# Periodos: off = desligado | Nd = N dias contando hoje (1d = so hoje, 2d = hoje e ontem)
#           Nm = N meses contando o atual (1m = mes atual, 2m = mes atual + anterior)
# Valor invalido impede o worker de iniciar.

# O que entra depois do onboarding (padrao 1m). off = nada automatico: sem vendas de hoje
# ao conectar, sem historico, sem atualizacao automatica e sem fechamento da madrugada
# (o Atualizar manual continua).
SYNC_ONBOARDING=1m

# Fechamento de ontem: hora local em que comeca (0-23). off = desligado.
CLOSE_HOUR=3

# Historico antigo na madrugada, mes a mes ate a inauguracao da loja (padrao off; so Nm).
DEEP_HISTORY=off

# Opcional: 1 = mostra no terminal cada etapa do sync (debug).
# SYNC_LOG_VERBOSE=1
